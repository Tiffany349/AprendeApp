
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEncabezado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/resources_title"
            android:textSize="24sp"
            android:textStyle="bold" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/logout"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            app:cornerRadius="12dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            app:icon="@android:drawable/ic_lock_power_off"
            app:iconTint="?attr/colorPrimary"
            app:iconPadding="4dp"
            app:iconGravity="textStart" />


    </LinearLayout>

    <!-- Buscador -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchRecursos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:iconifiedByDefault="false"
        android:queryHint="@string/search_resources_hint" />

    <!-- Filtro por tipo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/filter_type_label"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spFiltroTipo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:entries="@array/resource_type_filters" />

    <!-- Ordenamiento -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sort_resources_label"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spOrden"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginTop="8dp"
        android:entries="@array/resource_sort_options" />

    <!-- Administración docente -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdministrarRecursos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/open_teacher_management" />

    <!-- Favoritos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMostrarFavoritos"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/favorites_show"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/btn_star_big_on"
        app:iconGravity="textStart" />

    <!-- Indicador de carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Estado -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/loading_resources"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Lista de recursos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecursos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_recurso" />

</LinearLayout>
